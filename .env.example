PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skilllab?retryWrites=true&w=majority
JWT_SECRET=generate_a_long_random_string_for_this
FRONTEND_URL=http://localhost:5173

# First-run only. Used ONLY when the database contains no superadmin at all.
# Set both, start the server once, then DELETE them from the environment.
# Password must be at least 10 characters. No credential is hardcoded in the app.
# SEED_ADMIN_EMAIL=you@sheat.ac.in
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Super Admin
